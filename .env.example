# Copy to .env and adjust. Never commit .env.

# The hostname you'll browse to, e.g. a domain pointed at this machine's private IP. Use
# exactly the name in the address bar: passkeys only work at this name, and not at an IP.
ARESGATE_SERVER_NAME=aresgate.example.com
# Host ports. Keep 443 unless something else already uses it.
ARESGATE_HTTPS_PORT=443
ARESGATE_HTTP_PORT=80
TZ=UTC

# API worker processes.
ARESGATE_API_WORKERS=2

# To run a published release (`make pull`) rather than building the image here (`make up`):
# ARESGATE_IMAGE=ghcr.io/brianbaggs35/aresgate
# ARESGATE_VERSION=0.0.1

# The app secret key, which encrypts stored credentials and authenticator-app keys. Leave it
# unset and the container creates one in its data volume; set it (from `make secret-key`) when
# moving to a new server. It must be at least 32 characters.
# ARESGATE_SECRET_KEY=
