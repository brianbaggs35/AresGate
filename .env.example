# Copy to .env and adjust. Never commit .env.

# The hostname you'll browse to, e.g. a domain pointed at this machine's private IP. Use
# exactly the name in the address bar: passkeys only work at this name, and not at an IP.
ARESGATE_SERVER_NAME=aresgate.example.com
# For `make cert`, which gets a Let's Encrypt certificate for the name above through IONOS DNS
# (DOCS/quick-start.md). Neither is needed for anything else.
# ARESGATE_ACME_EMAIL=you@example.com
# DNS servers (host:port, comma-separated) that can see your domain's public records, if the ones
# your computer uses can't.
# ARESGATE_ACME_RESOLVERS=1.1.1.1:53
# Host ports. Keep 443 unless something else already uses it.
ARESGATE_HTTPS_PORT=443
ARESGATE_HTTP_PORT=80
TZ=UTC

# API worker processes.
ARESGATE_API_WORKERS=2

# To run a published release (`make pull`) rather than building the image here (`make up`):
# ARESGATE_IMAGE=ghcr.io/brianbaggs35/aresgate
# ARESGATE_VERSION=0.0.1

# The app secret key, which encrypts stored credentials and authenticator-app keys. Leave both
# of these unset and the container creates a key in its data volume the first time it starts.
# To bring a key from somewhere else, such as a restored backup (see `make secret-key`), set
# either one: the key itself, or the path of a file holding it, such as a Docker secret (see
# DOCS/operations.md). A key must be at least 32 characters.
# ARESGATE_SECRET_KEY=
# ARESGATE_SECRET_KEY_FILE=/run/secrets/aresgate_secret_key

# How long a sign-in lasts: until it has sat unused this long, or has lasted this long in all,
# whichever comes first.
# ARESGATE_SESSION_IDLE_MINUTES=30
# ARESGATE_SESSION_MAX_HOURS=12

# How many days the audit log keeps an event before it's deleted, from 1 to 3650.
# ARESGATE_AUDIT_RETENTION_DAYS=365

# How many days the integrations' API log keeps a call before it's deleted, from 1 to 365.
# ARESGATE_API_LOG_RETENTION_DAYS=30

# How many days the events read from the integrations are kept, from 1 to 3650, for an
# integration with no setting of its own (set in the API: see DOCS/operations.md).
# ARESGATE_EVENT_RETENTION_DAYS=30

# Whether the worker reads from the integrations on a schedule. "false" leaves it running but
# idle, which is how to pause collecting without stopping the container.
# ARESGATE_COLLECTORS_ENABLED=true

# How the API writes its logs: "json" (one object per line, what log tools expect) or "text".
# ARESGATE_LOG_FORMAT=json
# debug, info, warning or error.
# ARESGATE_LOG_LEVEL=info
